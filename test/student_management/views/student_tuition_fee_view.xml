<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="tuition_fee_form_view" model="ir.ui.view">
        <field name="name">tuition_fee_form_view</field>
        <field name="model">tuition.fee.structure</field>
        <field name="arch" type="xml">
            <form string="Student Tuition Fee">
                <sheet>
                    <group>
                        <group string="Student Details">
                            <field name="product_id"/>
                            <field name="fee_amount" force_save="1"/>
                            <field name="quantity"/>
                            <field name="discount"/>
                            <field name="subtotal"/>
                            <field name="total"/>
                            <field name="standard"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tuition_fee_list_view" model="ir.ui.view">
        <field name="name">tuition_fee_list_view</field>
        <field name="model">tuition.fee.structure</field>
        <field name="arch" type="xml">
            <list string="Student Tuition Fee">
                <field name="product_id"/>
                <field name="fee_amount"/>
                <field name="quantity"/>
                <field name="discount"/>
                <field name="subtotal"/>
                <field name="total"/>
                <field name="standard"/>
            </list>
        </field>
    </record>

    <record id="action_student_fee" model="ir.actions.act_window">
        <field name="name">Tuition Fee Structure</field>
        <field name="res_model">tuition.fee.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_student_fee" name="Tuition Fee Structure" parent="menu_student_management" action="action_student_fee"/>

</odoo>