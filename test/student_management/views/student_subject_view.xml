<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="student_subject_list_view" model="ir.ui.view">
        <field name="name">student_subject_list_view</field>
        <field name="model">subject.subject</field>
        <field name="arch" type="xml">
            <list string="Subject" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_student_subject" model="ir.actions.act_window">
        <field name="name">Subject</field>
        <field name="res_model">subject.subject</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_student_subject" name="Subject" parent="menu_student_management" action="action_student_subject"/>
</odoo>