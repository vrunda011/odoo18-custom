<?xml version="1.0" encoding="UTF-8"?>

<odoo>
   <data>
       <!-- Group Category -->
       <record id="module_student_activity" model="ir.module.category">
           <field name="name">Activity</field>
           <field name="description">Helps you to manage access of activities</field>
           <field name="parent_id" ref="base.module_category_sales"/>
       </record>

       <!-- Security Group -->
       <record id="activity_user_access" model="res.groups">
           <field name="name">User</field>
           <field name="category_id" ref="module_student_activity"/>

       </record>

       <record id="activity_admin_access" model="res.groups">
           <field name="name">Admin</field>
           <field name="category_id" ref="module_student_activity"/>
           <field name="implied_ids" eval="[(4, ref('activity_user_access'))]"></field>
       </record>

       <!-- Record rules-->
        <record id="activity_readonly_rule" model="ir.rule">
            <field name="name">User can only read all records</field>
            <field name="model_id" ref="model_student_activity"/>
            <field name="domain_force">[( 1, '=', 1 )]</field>
            <field name="groups" eval="[(4, ref('bista_crm.activity_user_access'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

       <record id="activity_admin_rule" model="ir.rule">
            <field name="name">Admin can access all except delete</field>
            <field name="model_id" ref="model_student_activity"/>
            <field name="domain_force">[( 1, '=', 1 )]</field>
            <field name="groups" eval="[(4, ref('bista_crm.activity_admin_access'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

<!--       <menuitem name="Activity"-->
<!--                  id="activity_menu_1"-->
<!--                  parent="overtime.menu_root"-->
<!--                  action="action_window"-->
<!--                  groups="activity_manager_access"/>-->
   </data>
</odoo>