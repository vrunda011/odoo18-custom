<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="action_open_stage" model="ir.actions.act_window">
        <field name="name">Percentage Stages</field>
        <field name="res_model">crm.percentage.stage</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="crm_percentage_stage_list_view"/>
    </record>

    <record id="action_open_activity" model="ir.actions.act_window">
        <field name="name">Student Activity</field>
        <field name="res_model">student.activity</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="crm_activity_list_view"/>
    </record>

    <menuitem id="crm_menu_pr_stages"
              name="Percentage Stages"
              parent="crm.crm_menu_root"
              sequence="21"
              action="action_open_stage"/>

    <menuitem id="crm_menu_activity"
              name="Student Activity"
              parent="crm.crm_menu_root"
              sequence="22"
              action="action_open_activity"/>
</odoo>