<odoo>
    <record id="email_template_purchase_approver" model="mail.template">
        <field name="name">Purchase Approval</field>
        <field name="model_id" ref="model_purchase_order"/>
        <field name="email_from">{{ object.env.user.email }}</field>
        <field name="subject">Approval for PO: {{ object.name }}</field>
        <field name="body_html" type="html">
            <p>Purchase Order: <strong><t t-out="object.name"/></strong></p>
            <p>Approver Name: <strong><t t-out="ctx.get('user_name')"/></strong></p>
        </field>
    </record>
</odoo>