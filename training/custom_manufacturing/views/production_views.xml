<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="production_form_view_inherit" model="ir.ui.view">
        <field name="name">production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_serial_wizard"
                        string="Generate Serial Numbers"
                        type="object"
                        class="btn-primary"/>
            </xpath>

            <field name="user_id" position="after">
                <field name="serial_ids" widget="many2many_tags" readonly="1"/>
            </field>

            <field name="serial_ids" position="after">
                <field name="id"/>
            </field>

            <xpath expr="//field[@name='lot_producing_id']" position='attributes'>
                <attribute name="domain">
                    [('id', 'in', serial_ids)]
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
