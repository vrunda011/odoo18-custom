<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="mo_report_wizard" model="ir.ui.view">
        <field name="name">mo.report.wizard</field>
        <field name="model">mo.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Report">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_print_mo_report"
                            type="object"
                            string="Print Excel"
                            class="oe_highlight"
                            icon="fa-download"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mo_report_wizard" model="ir.actions.act_window">
        <field name="name">Manufacturing Report</field>
        <field name="res_model">mo.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mo_report_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="mrp_menu_mo_report"
              name="MO Report"
              parent="mrp.menu_mrp_reporting"
              action="action_mo_report_wizard"/>
</odoo>