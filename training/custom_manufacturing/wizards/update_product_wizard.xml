<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="update_product_wizard" model="ir.ui.view">
        <field name="name">update.product.wizard</field>
        <field name="model">update.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Update">
                <group>
                    <group>
                        <field name="operation_type" widget="radio"/>
                    </group>
                    <group>
                        <field name="file"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_line_ids">
                                <list>
                                    <field name="order_number"/>
                                    <field name="current_product"/>
                                    <field name="new_product"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </group>
                <footer>
                    <button name="action_read_file" type="object" string="Read File" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>