<odoo>
    <record id="hotel_reservation_form_view" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm_reservation"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Paid" invisible="payment_status != 'paid'"/>
                    <widget name="web_ribbon" title="Partially Paid" invisible="payment_status != 'partially'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="res_code" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Reservation Info">
                            <field name="guest_id"/>
                            <field name="room_ids" widget="many2many_tags"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="state" invisible="1"/>
                        </group>
                        <group string="Payment Info">
                            <field name="currency_id"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_paid"/>
                            <field name="payment_status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_reservation_list_view" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations">
                <field name="guest_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="state"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <!--Search View-->
    <record id="hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="res_code" />
                <field name="guest_id" filter_domain="['|',('guest_id.partner_id.name','ilike',self),('guest_id.email','ilike',self)]" />
                <group expand="0" string="Group By">
                    <filter name="group_guest" string="Guests" domain="[]" context="{'group_by':'guest_id'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by':'state'}"/>
                </group>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirm" name="confirm" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Check In" name="check_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Check Out" name="check_out" domain="[('state', '=', 'checked_out')]"/>
                <separator/>
            </search>
        </field>
    </record>

    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hotel_reservation"
              name="Reservations"
              parent="hotel_main_menu"
              action="action_hotel_reservation"
              sequence="1"/>
</odoo>
