<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hotel_room_category_form_view" model="ir.ui.view">
        <field name="name">hotel.room.category.form</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <form string="Room Categories">
                <sheet>
                    <group string="Room Info">
                        <field name="name"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_room_category_list_view" model="ir.ui.view">
        <field name="name">hotel.room.category.list</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <list string="Room Categories">
                <field name="name"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <record id="action_room_category" model="ir.actions.act_window">
        <field name="name">Room Category</field>
        <field name="res_model">hotel.room.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hotel_room_category" name="Room Categories" parent="hotel_room_menu" action="action_room_category"/>

</odoo>
