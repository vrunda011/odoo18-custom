<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_housekeeping_task_form" model="ir.ui.view">
        <field name="name">housekeeping.task.form</field>
        <field name="model">housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_mark_as_complete" string="Complete" type="object" class="btn-primary" invisible="status != 'in_progress'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group string="Task Info">
                        <field name="room_id"/>
                        <field name="partner_id"/>
                        <field name="scheduled_date"/>
                    </group>
                    <group string="Cleaning Status">
                        <field name="status"/>
                        <field name="is_done" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_housekeeping_task_list" model="ir.ui.view">
        <field name="name">housekeeping.task.list</field>
        <field name="model">housekeeping.task</field>
        <field name="arch" type="xml">
            <list string="Housekeeping Tasks">
                <field name="room_id"/>
                <field name="partner_id"/>
                <field name="status"/>
                <field name="scheduled_date"/>
            </list>
        </field>
    </record>

    <record id="action_housekeeping_task" model="ir.actions.act_window">
        <field name="name">Housekeeping Tasks</field>
        <field name="res_model">housekeeping.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_housekeeping_tasks" name="Tasks" parent="hotel_main_menu" action="action_housekeeping_task"/>

</odoo>
