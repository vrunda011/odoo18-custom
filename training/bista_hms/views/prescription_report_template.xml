<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <template id="prescription_template">
       <t t-call="web.html_container">
           <t t-call="web.external_layout">
                <center>
                    <strong>
                        <h1>Prescription</h1>
                    </strong>
                </center>
               <t t-foreach="docs" t-as="o">
                   <strong>Patient Name: </strong><span t-field="o.patient_id.name" />
                   <br/>
                   <strong>Patient Age: </strong><span t-esc="o.patient_id.age or 0"/>
                   <br/>
                   <strong>Date: </strong><span t-field="o.date"/>
                   <br/>

                   <table width="100%" class="table">

                       <thead>
                           <tr>
                               <th>No.</th>
                               <th>Product</th>
                               <th style="text-align:right;">Price</th>
                               <th style="text-align:right;">Quantity</th>
                               <th style="text-align:right;">Total</th>
                           </tr>
                       </thead>
                       <tbody>
                           <t t-set="total_quantity" t-value="0"/>
                           <t t-set="total_amount" t-value="0"/>
                           <tr t-foreach="o.prescription_lines" t-as="line">
                                <td>
                                    <span t-esc="line_index + 1"/>
                                </td>
                                <td>
                                    <span t-field="line.product_id.display_name"/>
                                </td>
                                <td style="text-align:right;">
                                    <span t-field="line.price_unit"/>
                                </td>
                                <td style="text-align:right;">
                                    <span t-field="line.quantity"/>
                                </td>
                               <td style="text-align:right;">
                                    <span t-field="line.total"/>
                                </td>
                               <t t-set="total_quantity" t-value="total_quantity + line.quantity"/>
                               <t t-set="total_amount" t-value="total_amount + line.total"/>
                            </tr>
                           <tr>
                               <td colspan="3" style="text-align:right;">Total</td>
                               <td style="text-align:right;"><t t-out="total_quantity"/></td>
                               <td style="text-align:right;"><t t-out="total_amount"/></td>
                           </tr>
                       </tbody>
                   </table>
               </t>
           </t>
       </t>
    </template>
</odoo>
