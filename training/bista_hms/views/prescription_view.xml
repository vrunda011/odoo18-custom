<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="prescription_form_view" model="ir.ui.view">
        <field name="name">hms.prescription.form</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary"/>
                    <button name="action_create_delivery" string="Create Delivery" type="object" class="btn-primary"/>
                    <button name="action_draft" string="Draft" type="object" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <button name="action_confirmed" string="Confirmed" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_canceled" string="Canceled" type="object" class="btn-danger" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,canceled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_delivery" class="oe_stat_button" icon="fa-truck">
                                <field string="Delivery" name="delivery_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group string="Patient Information">
                            <field name="patient_id"/>
                            <field name="date" />
                        </group>
                        <notebook>
                            <page string="Prescriptions">
                                <field name="prescription_lines">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="delivered_qty"/>
                                        <field name="price_unit" readonly="1"/>
                                        <field name="total" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <group class="oe_subtotal_footer">
                            <field name="total_amount" class="oe_subtotal_footer_separator" widget="monetary" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="prescription_list_view" model="ir.ui.view">
        <field name="name">hms.prescription.list</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions">
                <field name="patient_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hms_prescriptions" model="ir.actions.act_window">
        <field name="name">prescription</field>
        <field name="res_model">hms.prescription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hms_prescription" name="Prescriptions" parent="menu_bista_hms" action="action_hms_prescriptions"/>
</odoo>