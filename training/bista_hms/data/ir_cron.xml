<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="appointment_reminder" model="ir.cron">
            <field name="name">Appointment Reminder Today</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._send_appointment_reminder_today()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="get_number_of_patient" model="ir.cron">
            <field name="name">Number of Patient</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="state">code</field>
            <field name="code">model._get_number_of_patient()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="weekly_consultation_report" model="ir.cron">
            <field name="name">Weekly Consultation Report</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._generate_weekly_consultation_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <record id="auto_cancel_overdue_appointments" model="ir.cron">
            <field name="name">Auto Cancel Overdue Appointments</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._auto_cancel_overdue_appointments()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="weekly_cancellation_report" model="ir.cron">
            <field name="name">Weekly Cancellation Report</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._weekly_cancellation_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <record id="create_weekly_appointment" model="ir.cron">
            <field name="name">Create Weekly Appointments</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="state">code</field>
            <field name="code">model._create_weekly_appointments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <record id="next_day_appointment_list" model="ir.cron">
            <field name="name">List of Appointments</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._send_mail_schedule()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>