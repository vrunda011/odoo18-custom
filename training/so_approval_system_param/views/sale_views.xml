<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sale_order_approve_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.approve.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                    <button name="button_approve"
                            type="object"
                            invisible="state != 'to approve'"
                            string="Approve Order"
                            class="oe_highlight"
                            groups="so_approval_system_param.group_sale_approver"/>
            </xpath>
        </field>
    </record>
</odoo>