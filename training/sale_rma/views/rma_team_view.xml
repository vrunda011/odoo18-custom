<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_rma_team_form" model="ir.ui.view">
        <field name="name">rma.team.form</field>
        <field name="model">rma.team</field>
        <field name="arch" type="xml">
            <form string="RMA Team">
                <sheet>
                    <group>
                        <group string="Team Information">
                            <field name="name"/>
                            <field name="prefix"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rma_team_list" model="ir.ui.view">
        <field name="name">rma.team.list</field>
        <field name="model">rma.team</field>
        <field name="arch" type="xml">
            <list string="Team">
                <field name="name"/>
                <field name="prefix"/>
            </list>
        </field>
    </record>

    <record id="action_rma_team" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="res_model">rma.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rma_team" name="Teams" parent="menu_sale_rma" action="action_rma_team"/>

</odoo>