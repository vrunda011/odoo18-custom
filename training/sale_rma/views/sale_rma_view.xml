<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_sale_rma_form" model="ir.ui.view">
        <field name="name">sale.rma.form</field>
        <field name="model">sale.rma</field>
        <field name="arch" type="xml">
            <form string="Sale RMA">
                <header>
                    <button name="action_rma_wizard"
                            string="Return"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_rma_invoice_wizard"
                            string="Create Invoice"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_picking"
                                class="oe_stat_button"
                                icon="fa-truck">
                            <field string="Pickings" name="picking_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="rma_code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Return Product Information">
                            <field name="team_id"/>
                            <field name="date"/>
                            <field name="so_id"/>
                        </group>
                        <notebook>
                            <page string="RMA lines">
                                <field name="rma_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="qty"/>
                                        <field name="price"/>
                                        <field name="to_receive_qty"/>
                                         <field name="to_invoice_qty"/>
                                        <field name="received_qty"/>
                                        <field name="invoiced_qty"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_rma_list" model="ir.ui.view">
        <field name="name">sale.rma.list</field>
        <field name="model">sale.rma</field>
        <field name="arch" type="xml">
            <list>
                <field name="rma_code" />
                <field name="team_id"/>
                <field name="date" />
                <field name="so_id" />
            </list>
        </field>
    </record>

    <record id="action_sale_rma" model="ir.actions.act_window">
        <field name="name">Sale RMA</field>
        <field name="res_model">sale.rma</field>
        <field name="view_mode">list,form</field>
<!--        <field name="model_id" ref="view_sale_rma_list"/>-->
    </record>

    <menuitem id="menu_sale_rma" name="Sale RMA"/>
    <menuitem id="menu_sale_rma_sub" name="RMA records" parent="menu_sale_rma" action="action_sale_rma"/>

</odoo>