<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="book_rental_form_view" model="ir.ui.view">
        <field name="name">library.book.rental.form</field>
        <field name="model">library.rental</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="rental_code"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Book Rental details">
                            <field name="borrower_id"/>
                            <field name="book_id"/>
                            <field name="rental_date"/>
                            <field name="return_date"/>
                        </group>
                        <group string="Other details">
                            <field name="state"/>
                            <field name="late_fee"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="book_rental_list_view" model="ir.ui.view">
        <field name="name">library.book.rental.list</field>
        <field name="model">library.rental</field>
        <field name="arch" type="xml">
            <list string="Book Rental">
                <field name="borrower_id"/>
                <field name="book_id"/>
                <field name="rental_date"/>
                <field name="return_date"/>
                <field name="state"/>
                <field name="late_fee"/>
            </list>
        </field>
    </record>

    <record id="action_library_book_rental" model="ir.actions.act_window">
        <field name="name">Book Rental</field>
        <field name="res_model">library.rental</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sub_menu_library_rental" name="Book Rental" parent="main_menu_library" action="action_library_book_rental"/>
</odoo>