<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- field with same name -->
            <xpath expr="//field[@name='partner_bank_id'][3]" position="after">
                <field name="remaining_amount" readonly="1"/>
            </xpath>
            <xpath expr="//group/notebook[@name='payment_notebook']" position="inside">
                <page string="Invoices">
                    <field name="invoice_payment_line_ids">
                        <list editable="bottom">
                            <field name="invoice_id"/>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="amount_allocation"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>