<?xml version="1.0" encoding="UTF-8"?>

<odoo>
   <data>
       <record id="group_loan_user" model="res.groups">
           <field name="name">Loan User</field>
       </record>

        <record id="group_loan_admin" model="res.groups">
            <field name="name">Loan Admin</field>
<!--            <field name="implied_ids" eval="[(4, ref('loan_management.group_loan_user'))]"/>-->
        </record>

        <record id="loan_user_rule" model="ir.rule">
            <field name="name">User records only</field>
            <field name="model_id" ref="model_loan_loan"/>
<!--            <field name="domain_force">[( 'create_ uid' , '=', user.id )]</field>-->
            <field name="domain_force">[('approval_level_ids.user_ids', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('loan_management.group_loan_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

   </data>

</odoo>
