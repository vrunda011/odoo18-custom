<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="loan_form_view" model="ir.ui.view">
        <field name="name">loan.form.view</field>
        <field name="model">loan.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculate_emi_lines"
                            string="Calculate Installments" type="object" />
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="loan_status != 'draft'" class="btn-primary"/>
                    <button name="button_approve" string="Approve Loan" type="object"
                            invisible="loan_status != 'to_approve' or is_user_approver == False" class="oe_highlight"
                            groups="loan_management.group_loan_user"/>
                    <button name="button_reject" string="Reject Loan" type="object"
                            invisible="loan_status != 'to_approve' or is_user_approver == False" class="oe_highlight"
                            groups="loan_management.group_loan_user"/>
                    <field name="loan_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_invoice" class="oe_stat_button" icon="fa-solid fa-list">
                            <field string="Invoices" name="invoice_count" widget="statinfo"/>
                        </button>
                        <button type="object" name="action_open_bill"  class="oe_stat_button" icon="fa-money">
                            <field string="Bills" name="bill_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group string="Loan Details">
                            <field name="partner_id"/>
                            <field name="pr_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="loan_period"/>
                            <field name="interest_amount"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="current_interest_rate" readonly="1"/>
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group string="Dates">
                            <field name="start_date"/>
                            <field name="end_date" readonly="1"/>
                        </group>
                        <group string="EMI Details">
                            <field name="emi_date"/>
                            <field name="emi_amount"/>
                        </group>
                        <group string="Loan Approval Details">
                            <field name="team_id"/>
                            <field name="next_approver_ids" widget="many2many_tags" invisible="loan_status != 'to_approve'"/>
                        </group>
                        <notebook>
                            <page string="Interest Rates">
                                <field name="rate_lines">
                                    <list editable="bottom" decoration-success="is_active==True">
                                        <field name="rate_date"/>
                                        <field name="rate"/>
                                        <field name="is_active" column_invisible="1"/>
                                        <button name="action_is_active" string="Active" type="object" class="oe_highlight" confirm="Are you sure you want to active this?" invisible="is_active==True"/>
                                    </list>
                                </field>
                            </page>
                            <page string="EMI Payments">
                                <field name="emi_lines">
                                    <list editable="bottom" decoration-danger="status == 'generated'" decoration-success="status == 'paid'">
                                        <field name="date"/>
                                        <field name="paid_amt"/>
                                        <field name="int_charged"/>
                                        <field name="total_payment"/>
                                        <field name="balance" />
                                        <field name="status" readonly="1" />
                                    </list>
                                </field>
                            </page>
                            <page string="Approval Levels">
                                <field name="approval_level_ids">
                                    <list editable="bottom">
                                        <field name="level_no"/>
                                        <field name="name"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="stage"/>
                                        <field name="approved_by" />
                                        <field name="rejected_by"/>
                                        <field name="time"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Pre Payments">
                                <field name="payment_ids">
                                    <list editable="bottom">
                                        <field name="payment_date"/>
                                        <field name="amount"/>
                                        <field name="payment_status" />
                                        <button name="action_pay_advance_payment"
                                                string="Pay"
                                                type="object"
                                                class="oe_highlight"
                                                invisible="payment_status == 'paid'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>

    <!--List View-->
    <record id="loan_list_view" model="ir.ui.view">
        <field name="name">loan.list.view</field>
        <field name="model">loan.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="pr_amount"/>
                <field name="loan_period"/>
                <field name="currency_id" invisible="1" />
            </list>
        </field>
    </record>

    <!-- kanban view -->
    <record id="loan_view_kanban" model="ir.ui.view">
       <field name="name">loan.view.kanban</field>
       <field name="model">loan.loan</field>
       <field name="arch" type="xml">
           <kanban class="o_kanban_mobile" default_group_by='loan_status' sample="1" quick_create="true">
               <progressbar field="loan_status"
                   colors='{"approved": "success", "to_approve": "warning", "rejected": "danger"}'/>
               <templates>
                   <t t-name="card">
                       <div class="d-flex mb-2" style="justify-content: space-between;">
                           <field name="partner_id" class="fw-bolder fs-5" />
                       </div>
                       <div class="text-muted">Loan Date:
                            <field name="start_date"/>
                       </div>
                       <div class="text-muted">Loan Amount:
<!--                           <label for="pr_amount">Loan Amount:</label>-->
                           <field name="pr_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                       </div>
                       <footer>
<!--                           <div class="ms-auto"> Position: Right side-->
                           <div>
                           <field name="loan_status"
                               widget="label_selection"
                               options="{'classes': {'draft': 'info', 'to_approve': 'default', 'approved': 'success', 'rejected': 'danger'}}" class="ms-auto"/>
                           </div>
                       </footer>
                   </t>
               </templates>
           </kanban>
       </field>
   </record>

    <record id="action_open_loan_view" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">loan.loan</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="loan_main_menu" name="LMS"/>
    <menuitem id="loan_sub_menu" name="Loans" parent="loan_main_menu" action="action_open_loan_view"/>
</odoo>