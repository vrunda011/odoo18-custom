<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="loan_rate_list_view" model="ir.ui.view">
        <field name="name">loan.rate.list.view</field>
        <field name="model">loan.rate</field>
        <field name="arch" type="xml">
            <list>
                <field name="rate"/>
                <field name="rate_date"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="action_open_loan_rate_view" model="ir.actions.act_window">
        <field name="name">Rates</field>
        <field name="res_model">loan.rate</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="loan_rates_menu" name="Rates" parent="loan_main_menu" action="action_open_loan_rate_view"/>
</odoo>