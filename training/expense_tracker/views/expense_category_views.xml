<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="expense_category_list_view" model="ir.ui.view">
        <field name="name">expense.category.list.view</field>
        <field name="model">expense.category</field>
        <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="category_expense_ids" />
        </list>
        </field>
    </record>


    <record id="expense_category_action" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">expense.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="expense_sub_root_menu2" name="Expense Category" parent="expense_root_menu" action="expense_category_action"/>
</odoo>
