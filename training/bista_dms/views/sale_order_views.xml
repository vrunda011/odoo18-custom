<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="sale_order_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="tags_ids" widget="many2many_tags"/>
            </field>
            <field name="tags_ids" position="after">
                <field name="document_ids" widget="many2many_tags" readonly="1"/>
            </field>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_get_documents" string="Get Documents" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>