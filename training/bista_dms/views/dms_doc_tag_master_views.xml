<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_dms_doc_tag_list" model="ir.ui.view">
        <field name="name">dms.doc.tag.list</field>
        <field name="model">doc.tag.master</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_doc_tag" model="ir.actions.act_window">
        <field name="name">Doc Tags</field>
        <field name="res_model">doc.tag.master</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_doc_tag_list" name="Tags" parent="menu_bista_dms" action="action_doc_tag"/>
</odoo>