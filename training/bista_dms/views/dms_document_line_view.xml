<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_dms_doc_line_list" model="ir.ui.view">
        <field name="name">dms.doc.line.list</field>
        <field name="model">document.line</field>
        <field name="arch" type="xml">
            <list string="Lines" editable="bottom">
                <field name="so_document_id"/>
                <field name="doc_id"/>
                <field name="product_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="so_doc_search" model="ir.ui.view">
        <field name="name">so.doc.search</field>
        <field name="model">document.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="so_document_id" filter_domain="['|','|',('doc_id','ilike',self),('so_document_id','ilike',self),('product_ids','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="action_doc_line" model="ir.actions.act_window">
        <field name="name">Doc Lines</field>
        <field name="res_model">document.line</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_doc_line" name="Lines" parent="menu_bista_dms" action="action_doc_line"/>
</odoo>