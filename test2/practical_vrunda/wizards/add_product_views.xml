<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="add_product_wizard_wizard" model="ir.ui.view">
        <field name="name">add.product.wizard.wizard</field>
        <field name="model">add.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Products">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_add_product" type="object" string="Add" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>