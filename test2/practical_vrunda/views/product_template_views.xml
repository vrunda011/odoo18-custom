<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="product_template_view_inherit" model="ir.ui.view">
        <field name="name">product.template.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='default_code']" position="after">
                <field name="pharmacy_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <search>
                <field name="pharmacy_id"/>
            </search>
        </field>
    </record>
</odoo>