<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="sale_order_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="inside">
                <button name="action_view_add_product"
                        string="Add Products"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//header/button[@name='action_confirm']" position="before">
                    <button name="button_approve"
                            type="object"
                            invisible="state != 'to approve'"
                            string="Approve Order"
                            class="oe_highlight"
                            groups="sales_team.group_sale_manager"
                            data-hotkey="z"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//field[@name='tag_ids']" position="after">
                <field name="total_so_lines"/>
            </xpath>
        </field>
    </record>
</odoo>