<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="mail_activity_schedule_view_form" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.inherit.pr</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group//field[@name='activity_type_id']" position="attributes">
                <attribute name="string">Connection</attribute>
            </xpath>
            <xpath expr="//group//field[@name='activity_type_id']" position="after">
                <field name="meaningful_conn"/>
            </xpath>
            <xpath expr="//group//field[@name='activity_user_id']" position="attributes">
                <attribute name="domain">
                    [("share", "=", False)]
                </attribute>
            </xpath>
            <xpath expr="//button[@name='action_schedule_activities']" position="after">
                or
            </xpath>
            <xpath expr="//button[@name='action_schedule_activities_done']" position="after">
                or
            </xpath>
            <xpath expr="//button[@name='action_schedule_activities_done_and_schedule']" position="after">
                or
            </xpath>
        </field>
    </record>
</odoo>