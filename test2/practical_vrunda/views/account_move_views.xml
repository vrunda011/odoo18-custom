<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//sheet//widget" position="after">
                <widget name="web_ribbon" title="Draft" invisible="state != 'draft'"/>
                <widget name="web_ribbon" title="Posted" invisible="state != 'posted'"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>
            <xpath expr="//notebook/page[@id='invoice_tab']//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>